<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:vm="clr-namespace:CrossCam.ViewModel"
               xmlns:vc="clr-namespace:CrossCam.ValueConverter"
               xmlns:ce="clr-namespace:CrossCam.CustomElement"
               xmlns:views="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:page="clr-namespace:CrossCam.Page"
               xmlns:lazyViews="clr-namespace:CrossCam.CustomElement.LazyViews"
               xmlns:localization="clr-namespace:CrossCam.Resources.Localization"
               x:DataType="vm:SettingsViewModel"
               x:Class="CrossCam.Page.SettingsPage"
               Title="{x:Static localization:AppResources.Title_Settings}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label"
                   BasedOn="{StaticResource _baseLabelStyle}">
                <Setter Property="Margin"
                        Value="10"/>
                <Setter Property="VerticalTextAlignment"
                        Value="Center"/>
                <Setter Property="HorizontalOptions"
                        Value="StartAndExpand"/>
            </Style>
            <Style TargetType="Switch">
                <Setter Property="Margin"
                        Value="10"/>
            </Style>
            <Style TargetType="Border">
                <Setter Property="Stroke"
                        Value="White"/>
                <Setter Property="Margin"
                        Value="1"/>
                <Setter Property="Padding"
                        Value="1"/>
            </Style>
            <Style TargetType="Entry">
                <Setter Property="Keyboard"
                        Value="Numeric"/>
                <Setter Property="BackgroundColor"
                        Value="White"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView VerticalOptions="StartAndExpand">
        <StackLayout>

            <ce:iOS12WorkaroundBackButton/>
            <ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="{x:Static localization:AppResources.Page_Settings_Preview}"
                                       Icon="eye.png"/>
                </ce:AutomaticallyClosingExpander.Header>
                <lazyViews:PreviewMethodSettingsLazyView/>
            </ce:AutomaticallyClosingExpander>

            <!--<ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander x:Name="_captureMethodExpander"
                            Command="{Binding CloseOtherExpandersCommand}"
                            CommandParameter="{x:Reference _captureMethodExpander}"
                            IsExpanded="{Binding OpenExpander, Converter={vc:IsBindingEqualToParameterConverter}, ConverterParameter={x:Reference _captureMethodExpander}}"
                            ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="Capture Method"
                                       Icon="aperture.png"/>
                </ce:AutomaticallyClosingExpander.Header>
            </ce:AutomaticallyClosingExpander>-->

            <ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="{x:Static localization:AppResources.Page_Settings_Pairing}"
                                       Icon="pair.png"/>
                </ce:AutomaticallyClosingExpander.Header>
                <lazyViews:PairSettingsLazyView/>
            </ce:AutomaticallyClosingExpander>

            <ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="{x:Static localization:AppResources.Page_Settings_Alignment}"
                                       Icon="smarttoy.png"/>
                </ce:AutomaticallyClosingExpander.Header>
                <lazyViews:AlignmentSettingsLazyView/>
            </ce:AutomaticallyClosingExpander>

            <ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander x:Name="_savingExpander"
                            ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="{x:Static localization:AppResources.Page_Settings_Saving}"
                                       Icon="checkbox.png"/>
                </ce:AutomaticallyClosingExpander.Header>
                <lazyViews:SavingSettingsLazyView/>
            </ce:AutomaticallyClosingExpander>

            <ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="{x:Static localization:AppResources.Page_Settings_Border}"
                                       Icon="squareouter.png"/>
                </ce:AutomaticallyClosingExpander.Header>
                <lazyViews:BorderSettingsLazyView/>
            </ce:AutomaticallyClosingExpander>

            <ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="{x:Static localization:AppResources.Page_Settings_Guides}"
                                       Icon="horizontalleveloutside.png"/>
                </ce:AutomaticallyClosingExpander.Header>
                <lazyViews:GuidesSettingsLazyView/>
            </ce:AutomaticallyClosingExpander>

            <ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="{x:Static localization:AppResources.Page_Settings_Editing}"
                                       Icon="edit.png"/>
                </ce:AutomaticallyClosingExpander.Header>
                <lazyViews:EditingSettingsLazyView/>
            </ce:AutomaticallyClosingExpander>

            <ce:HorizontalDivider/>

            <ce:AutomaticallyClosingExpander ExpandedChanged="ExpanderChanged">
                <ce:AutomaticallyClosingExpander.Header>
                    <ce:ExpanderHeader Title="{x:Static localization:AppResources.Page_Settings_Camera}"
                                       Icon="camerasettings.png"/>
                </ce:AutomaticallyClosingExpander.Header>
                <lazyViews:CameraSettingsLazyView/>
            </ce:AutomaticallyClosingExpander>

            <ce:HorizontalDivider/>

            <StackLayout Orientation="Horizontal">
                <Label Text="Force English Language (requires an app force-close and restart to take effect)"/>
                <Switch IsToggled="{Binding Settings.ForceEnglish}"/>
            </StackLayout>

            <ce:HorizontalDivider/>

            <StackLayout Orientation="Horizontal">
                <Label Text="{x:Static localization:AppResources.Page_Settings_ErrorEmail}"/>
                <Switch IsToggled="{Binding Settings.PromptForErrorEmails}"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal">
                <Label Text="{x:Static localization:AppResources.Page_Settings_Analytics}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetAnalyticsToDebugModeCommand}" 
                                              NumberOfTapsRequired="2"/>
                    </Label.GestureRecognizers>
                </Label>
                <Switch IsToggled="{Binding Settings.IsAnalyticsEnabled}"/>
            </StackLayout>

            <ce:HorizontalDivider/>
            <Button Text="{x:Static localization:AppResources.Page_Settings_Defaults}"
                    Command="{Binding ResetToDefaults}"/>

            <ce:HorizontalDivider/>
            <ce:FooterLabel/>
        </StackLayout>
    </ScrollView>
</page:BasePage>