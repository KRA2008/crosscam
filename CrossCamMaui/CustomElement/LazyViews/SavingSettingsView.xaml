<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:vm="clr-namespace:CrossCam.ViewModel"
      xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
      xmlns:localization="clr-namespace:CrossCam.Resources.Localization"
      x:Class="CrossCam.CustomElement.LazyViews.SavingSettingsView"
      x:DataType="vm:SettingsViewModel"
      ColumnSpacing="0">
    <Grid.Resources>
        <ResourceDictionary>
            <x:Double x:Key="saveModesHeight">15</x:Double>
            <Style TargetType="Image"
                   x:Key="saveModes">
                <Setter Property="HeightRequest"
                        Value="{StaticResource saveModesHeight}"/>
                <Setter Property="HorizontalOptions"
                        Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="30"/>
        <ColumnDefinition Width="65"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="60"/>
        <RowDefinition Height="60"/>
        <RowDefinition Height="75"/>
        <RowDefinition Height="70"/>
        <RowDefinition Height="70"/>
        <RowDefinition Height="70"/>
        <RowDefinition Height="70"/>
        <RowDefinition Height="75"/>
        <RowDefinition Height="70"/>
        <RowDefinition Height="70"/>
        <RowDefinition Height="75"/>
        <RowDefinition Height="60"/>
        <RowDefinition Height="75"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Label Grid.Row="0"
       Grid.Column="0"
       Text="{Binding Settings.ResolutionProportion, StringFormat='{0}%'}"
       FontSize="{StaticResource saveModesHeight}"/>
    <Label Grid.Row="0"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Resolution}"/>
    <Frame Grid.Row="0"
       Grid.Column="3"
       WidthRequest="50"
       HorizontalOptions="End">
        <Picker ItemsSource="{Binding ZeroToOneHundred}"
            SelectedIndex="{Binding Settings.ResolutionProportion}"
            HorizontalOptions="FillAndExpand"/>
    </Frame>

    <Label Grid.Row="1"
       Grid.Column="0"
       Grid.ColumnSpan="3"
       Text="{x:Static localization:AppResources.Settings_Saving_Clear}"/>
    <Switch Grid.Row="1"
        Grid.Column="3"
        IsToggled="{Binding Settings.ClearCapturesAfterSave}"/>

    <Label Grid.Row="2"
       Grid.Column="0"
       Grid.ColumnSpan="4"
       Text="{x:Static localization:AppResources.Settings_Saving_Order}"
       HorizontalOptions="CenterAndExpand"/>

    <Image Grid.Row="3"
       Grid.Column="0"
       Source="saveboth.png"
       Style="{StaticResource saveModes}"/>
    <Label Grid.Row="3"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Separate}"/>
    <Switch Grid.Row="3"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveSidesSeparately}"/>

    <Image Grid.Row="4"
       Grid.Column="0"
       Source="crossed.png"
       Style="{StaticResource saveModes}">
        <Image.Triggers>
            <DataTrigger TargetType="Image"
                     Binding="{Binding Settings.Mode, Converter={StaticResource enumCompare}, ConverterParameter={x:Static vm:DrawMode.Parallel}}"
                     Value="True">
                <Setter Property="Grid.Row"
                    Value="5"/>
            </DataTrigger>
        </Image.Triggers>
    </Image>
    <Label Grid.Row="4"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Cross}">
        <Label.Triggers>
            <DataTrigger TargetType="Label"
                     Binding="{Binding Settings.Mode, Converter={StaticResource enumCompare}, ConverterParameter={x:Static vm:DrawMode.Parallel}}"
                     Value="True">
                <Setter Property="Grid.Row"
                    Value="5"/>
            </DataTrigger>
        </Label.Triggers>
    </Label>
    <Switch Grid.Row="4"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveForCrossView}">
        <Switch.Triggers>
            <DataTrigger TargetType="Switch"
                     Binding="{Binding Settings.Mode, Converter={StaticResource enumCompare}, ConverterParameter={x:Static vm:DrawMode.Parallel}}"
                     Value="True">
                <Setter Property="Grid.Row"
                    Value="5"/>
            </DataTrigger>
        </Switch.Triggers>
    </Switch>

    <Image Grid.Row="5"
       Grid.Column="0"
       Source="parallel.png"
       Style="{StaticResource saveModes}">
        <Image.Triggers>
            <DataTrigger TargetType="Image"
                     Binding="{Binding Settings.Mode, Converter={StaticResource enumCompare}, ConverterParameter={x:Static vm:DrawMode.Parallel}}"
                     Value="True">
                <Setter Property="Grid.Row"
                    Value="4"/>
            </DataTrigger>
        </Image.Triggers>
    </Image>
    <Label Grid.Row="5"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Parallel}">
        <Label.Triggers>
            <DataTrigger TargetType="Label"
                     Binding="{Binding Settings.Mode, Converter={StaticResource enumCompare}, ConverterParameter={x:Static vm:DrawMode.Parallel}}"
                     Value="True">
                <Setter Property="Grid.Row"
                    Value="4"/>
            </DataTrigger>
        </Label.Triggers>
    </Label>
    <Switch Grid.Row="5"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveForParallel}">
        <Switch.Triggers>
            <DataTrigger TargetType="Switch"
                     Binding="{Binding Settings.Mode, Converter={StaticResource enumCompare}, ConverterParameter={x:Static vm:DrawMode.Parallel}}"
                     Value="True">
                <Setter Property="Grid.Row"
                    Value="4"/>
            </DataTrigger>
        </Switch.Triggers>
    </Switch>

    <Image Grid.Row="6"
       Grid.Column="0"
       Source="anaglyph.png"
       Style="{StaticResource saveModes}"/>
    <Label Grid.Row="6"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Anaglyph}"/>
    <Switch Grid.Row="6"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveForRedCyanAnaglyph}"/>

    <Image Grid.Row="7"
       Grid.Column="0"
       Source="grayscaleanaglyph.png"
       Style="{StaticResource saveModes}"/>
    <Label Grid.Row="7"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Grayscale}"/>
    <Switch Grid.Row="7"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveForGrayscaleAnaglyph}"/>

    <Image Grid.Row="8"
       Grid.Column="0"
       Source="saveone.png"
       Style="{StaticResource saveModes}"/>
    <Label Grid.Row="8"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Alone}"/>
    <Switch Grid.Row="8"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveRedundantFirstSide}"
        IsEnabled="{Binding EnableFirstSideAloneSwitch}"/>

    <Image Grid.Row="9"
       Grid.Column="0"
       Source="triple.png"
       Style="{StaticResource saveModes}"/>
    <Label Grid.Row="9"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Triple}"/>
    <Switch Grid.Row="9"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveForTriple}"/>

    <Image Grid.Row="10"
       Grid.Column="0"
       Source="quad.png"
       Style="{StaticResource saveModes}"
       HeightRequest="25"/>
    <Label Grid.Row="10"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Quad}"/>
    <Switch Grid.Row="10"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveForQuad}"/>

    <Label Grid.Row="11"
       Grid.Column="0"
       HorizontalOptions="Center"
       Text="VR"/>
    <Label Grid.Row="11"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Text="{x:Static localization:AppResources.Settings_Saving_Cardboard}"/>
    <Switch Grid.Row="11"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveForCardboard}"/>

    <Label Grid.Row="12"
       Grid.Column="0"
       Grid.ColumnSpan="3"
       Text="{x:Static localization:AppResources.Settings_Saving_Folder}"/>
    <Switch Grid.Row="12"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveIntoDedicatedFolder2}"/>

    <Label Grid.Row="13"
       Grid.Column="0"
       Grid.ColumnSpan="3"
       Text="{x:Static localization:AppResources.Settings_Saving_Subfolder}"/>
    <Switch Grid.Row="13"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveIntoSeparateFolders1}"/>

    <Label Grid.Row="14"
       Grid.Column="0"
       Grid.ColumnSpan="2"
       IsVisible="{Binding CanSaveToArbitraryDirectory}">
        <Label.FormattedText>
            <FormattedString>
                <Span Text="{x:Static localization:AppResources.Settings_Saving_SaveTo}"/>
                <Span Text="{Binding SaveDirectory}"/>
            </FormattedString>
        </Label.FormattedText>
    </Label>
    <Button Grid.Row="14"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Command="{Binding ChooseDirectory}"
        Text="{x:Static localization:AppResources.Settings_Saving_Browse}"
        IsVisible="False">
        <Button.Triggers>
            <MultiTrigger TargetType="Button">
                <MultiTrigger.Conditions>
                    <BindingCondition Binding="{Binding CanSaveToArbitraryDirectory}"
                                  Value="True"/>
                    <BindingCondition Binding="{Binding Settings.SavingDirectory}"
                                  Value="{x:Null}"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="IsVisible"
                        Value="True"/>
                </MultiTrigger.Setters>
            </MultiTrigger>
        </Button.Triggers>
    </Button>

    <Button Grid.Row="14"
        Grid.Column="2"
        Grid.ColumnSpan="2"
        Command="{Binding ClearDirectory}"
        Text="{x:Static localization:AppResources.Settings_Saving_Reset}"
        IsVisible="{Binding Settings.SavingDirectory, Converter={toolkit:IsNotNullConverter}}"/>

    <Label Grid.Row="15"
       Grid.Column="0"
       Grid.ColumnSpan="2"
       Text="{Binding ExternalDirectory, StringFormat='{0}'}"
       IsVisible="{Binding CanSaveToExternalDirectory}">
        <Label.FormattedText>
            <FormattedString>
                <Span Text="{x:Static localization:AppResources.Settings_Saving_ExternalDirectory}"/>
                <Span Text="{Binding ExternalDirectory}"/>
                <Span Text="{x:Static localization:AppResources.Settings_Saving_ExternalWarning}"/>
            </FormattedString>
        </Label.FormattedText>
    </Label>
    <Switch Grid.Row="15"
        Grid.Column="3"
        IsToggled="{Binding Settings.SaveToExternal}"
        IsVisible="{Binding CanSaveToExternalDirectory}"/>
</Grid>