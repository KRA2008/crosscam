<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:vm="clr-namespace:CrossCam.ViewModel"
      xmlns:model="clr-namespace:CrossCam.Model"
      xmlns:localization="clr-namespace:CrossCam.Resources.Localization"
      x:Class="CrossCam.CustomElement.LazyViews.AlignmentSettingsView"
      x:DataType="vm:SettingsViewModel"
      RowSpacing="0"
      ColumnSpacing="0">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="50"/>
        <ColumnDefinition Width="65"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="0"/> <!-- too lazy to remove and renumber -->
        <RowDefinition Height="50"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="0"/><!-- too lazy to remove and renumber -->
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="50"/>
    </Grid.RowDefinitions>

    <Label Grid.Column="0"
       Grid.Row="1"
       Text="{x:Static localization:AppResources.Settings_Alignment_On}"/>
    <Image Grid.Row="1"
       Grid.Column="1" 
       Source="help.png">
        <Image.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NavigateToFaqPageAndSection}" 
                              CommandParameter="{x:Static model:FaqScrollOptions.AutoAlignment}"/>
        </Image.GestureRecognizers>
    </Image>
    <Switch Grid.Column="2"
        Grid.Row="1"
        IsToggled="{Binding Settings.AlignmentSettings.IsAutomaticAlignmentOn}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="2"
       Text="{x:Static localization:AppResources.Settings_Alignment_Keypoints}"
       IsVisible="{Binding Settings.AlignmentSettings.IsAutomaticAlignmentOn}"/>
    <Switch Grid.Column="2"
        Grid.Row="2"
        IsToggled="{Binding Settings.AlignmentSettings.ForceKeypoints3}"
        IsVisible="{Binding Settings.AlignmentSettings.IsAutomaticAlignmentOn}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="3"
       Text="{x:Static localization:AppResources.Settings_Alignment_Ecc}"
       IsVisible="{Binding Settings.AlignmentSettings.IsAutomaticAlignmentOn}"/>
    <Switch Grid.Column="2"
        Grid.Row="3"
        IsToggled="{Binding Settings.AlignmentSettings.ForceEcc2}"
        IsVisible="{Binding Settings.AlignmentSettings.IsAutomaticAlignmentOn}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="4"
       Text="{x:Static localization:AppResources.Settings_Alignment_Advanced}"
       IsVisible="{Binding Settings.AlignmentSettings.IsAutomaticAlignmentOn}"/>
    <Switch Grid.Column="2"
        Grid.Row="4"
        IsToggled="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"
        IsVisible="{Binding Settings.AlignmentSettings.IsAutomaticAlignmentOn}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="5"
       Text="Save drawn result warped by OpenCv"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Switch Grid.Column="2"
        Grid.Row="5"
        IsToggled="{Binding Settings.AlignmentSettings.DrawResultWarpedByOpenCv}"
        IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="6"
       Text="Intermediate downsize percentage"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="6"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Entry Text="{Binding Settings.AlignmentSettings.DownsizePercentage2}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="7"
       HorizontalOptions="CenterAndExpand"
       Text="Keypoint settings"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="8"
       Text="Transformation finding method"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="8"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Picker ItemsSource="{Binding TransformationFindingMethods}"
            SelectedIndex="{Binding Settings.AlignmentSettings.TransformationFindingMethod3}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="9"
       Text="Crosscheck keypoints (vs ratio checks)"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Switch Grid.Column="2"
        Grid.Row="9"
        IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="10"
       Text="Minimum keypoints"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="10"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Entry Text="{Binding Settings.AlignmentSettings.MinimumKeypoints2}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="11"
       Text="Discard outliers by distance"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Switch Grid.Column="2"
        Grid.Row="11"
        IsToggled="{Binding Settings.AlignmentSettings.DiscardOutliersByDistance2}"
        IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="12"
       Text="Discard outliers by slope"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Switch Grid.Column="2"
        Grid.Row="12"
        IsToggled="{Binding Settings.AlignmentSettings.DiscardOutliersBySlope2}"
        IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="13"
       Text="Keypoint outlier threshold (tenths of standard deviation)"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="13"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Entry Text="{Binding Settings.AlignmentSettings.KeypointOutlierThresholdTenths}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="14"
       Text="Save an unaligned joined copy with matches drawn"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Switch Grid.Column="2"
        Grid.Row="14"
        IsToggled="{Binding Settings.AlignmentSettings.DrawKeypointMatches}"
        IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="15"
       Text="Do keystone correction"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Switch Grid.Column="2"
        Grid.Row="15"
        IsToggled="{Binding Settings.AlignmentSettings.DoKeystoneCorrection1}"
        IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="16"
       Text="Ratio test"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="16"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Entry Text="{Binding Settings.AlignmentSettings.RatioTest}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="18"
       Text="Read mode color"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Switch Grid.Column="2"
        Grid.Row="18"
        IsToggled="{Binding Settings.AlignmentSettings.ReadModeColor1}"
        IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>



    <Label Grid.Column="0"
       Grid.ColumnSpan="3"
       Grid.Row="19"
       Text="Ecc settings"
       HorizontalOptions="CenterAndExpand"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="20"
       Text="Iterations"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="20"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Entry Text="{Binding Settings.AlignmentSettings.EccIterations}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="21"
       Text="Epsilon level"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="21"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Entry Text="{Binding Settings.AlignmentSettings.EccEpsilonLevel}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="22"
       Text="Downsized pyramid estimating layers"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="22"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Entry Text="{Binding Settings.AlignmentSettings.EccPyramidLayers}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="23"
       Text="Minimum required correlation coefficient"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="23"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Entry Text="{Binding Settings.AlignmentSettings.EccThresholdPercentage}"/>
    </Border>

    <Label Grid.Column="0"
       Grid.ColumnSpan="2"
       Grid.Row="24"
       Text="Motion type"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}"/>
    <Border Grid.Column="2"
       Grid.Row="24"
       IsVisible="{Binding Settings.AlignmentSettings.ShowAdvancedAlignmentSettings1}">
        <Picker ItemsSource="{Binding MotionTypes}"
            SelectedIndex="{Binding Settings.AlignmentSettings.EccMotionType}"/>
    </Border>

    <Button Grid.Column="0"
        Grid.ColumnSpan="3"
        Grid.Row="25"
        Text="{x:Static localization:AppResources.Settings_Reset}"
        Command="{Binding ResetAlignmentToDefaults}"/>
</Grid>