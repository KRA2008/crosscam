<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:ce="clr-namespace:CrossCam.CustomElement"
               xmlns:vm="clr-namespace:CrossCam.ViewModel"
               xmlns:page="clr-namespace:CrossCam.Page"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:localization="clr-namespace:CrossCam.Resources.Localization"
               x:Class="CrossCam.Page.TipMePage"
               x:DataType="vm:TipMeViewModel"
               Title="{x:Static localization:AppResources.Title_TipMe}">
    <ScrollView>
        <StackLayout>
            <ce:iOS12WorkaroundBackButton/>
            <ce:HorizontalDivider/>
            <StackLayout Padding="15,15,15,15">
                <Label Text="{x:Static localization:AppResources.Page_TipMe_1}"/>
                <Label IsVisible="{Binding TipsTotal, Converter={toolkit:IsNotNullConverter}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static localization:AppResources.Page_TipMe_Tipped}"/>
                            <Span Text="{Binding TipsCount}"/>
                            <Span Text="{x:Static localization:AppResources.Page_TipMe_TippedTimes}"/>
                            <Span Text="{Binding TipsTotal, StringFormat='${0:D}'}"/>
                            <Span Text="."/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{x:Static localization:AppResources.Page_TipMe_2}"/>
            </StackLayout>
            <ce:HorizontalDivider/>
            <Button Text="{x:Static localization:AppResources.Page_TipMe_Ko_fi}"
                    Command="{Binding OpenLink}"
                    CommandParameter="https://ko-fi.com/kra2008"/>
            <ce:HorizontalDivider/>
            <Button Text="{x:Static localization:AppResources.Page_TipMe_PayPal}"
                    Command="{Binding OpenLink}"
                    CommandParameter="https://paypal.com/paypalme/KRA2008"/>
            <ce:HorizontalDivider/>
            <Button Text="{x:Static localization:AppResources.Page_TipMe_Patreon}"
                    Command="{Binding OpenLink}"
                    CommandParameter="https://patreon.com/kra2008"/>
            <ce:HorizontalDivider/>
            <Button Text="{x:Static localization:AppResources.Page_TipMe_Venmo}"
                    Command="{Binding OpenLink}"
                    CommandParameter="https://account.venmo.com/u/kra2008"/>
            <ce:HorizontalDivider/>
            <ce:FooterLabel/>
        </StackLayout>
    </ScrollView>
</page:BasePage>